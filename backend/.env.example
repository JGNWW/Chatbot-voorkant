# Kopieer dit bestand naar .env en vul je Anthropic API-sleutel in.
ANTHROPIC_API_KEY=sk-ant-...

# Model voor het kiezen van de juiste pagina (snel/goedkoop).
SELECTION_MODEL=claude-haiku-4-5-20251001

# Model voor het overnemen van het letterlijke antwoord (krachtig/nauwkeurig).
ANSWER_MODEL=claude-sonnet-4-6

# Basis-URL van de bron-website.
SITE_BASE_URL=https://www.nederlandwereldwijd.nl

# Sitemap-index met alle pagina's.
SITEMAP_URL=https://www.nederlandwereldwijd.nl/paginas/sitemap.xml

# Hoe lang (seconden) de sitemap in het geheugen gecachet blijft.
SITEMAP_TTL_SECONDS=86400

# Toegestane origin(s) van de frontend (komma-gescheiden).
CORS_ORIGINS=http://localhost:5173
